# Copy to .env (or just export these) to enable the REAL ALX-1 / Lighthouse path.
# Without a key the app still runs, in clearly-labeled SIMULATED mode.

# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-opus-4-8).
# ALEX_MODEL=claude-opus-4-8

# Optional: force the offline simulation even if a key is present.
# ALEX_FORCE_DEMO=1

# Optional: port (default 4173).
# PORT=4173
